{
    "name": "activate-dashboard",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev-sparql": "concurrently --kill-others \"npm run sparql\" \"vite\"",
        "build": "vue-tsc -b && vite build",
        "preview": "vite preview",
        "format": "prettier --write .",
        "format-check": "prettier --check .",
        "sparql": "npm run sparql:env && npm run sparql:setup && npm run sparql:serve",
        "sparql:env": "python -m venv ./activate_env && source ./activate_env/bin/activate",
        "sparql:setup": "pip install --upgrade pip && pip install rdflib-endpoint uvicorn",
        "sparql:serve": "rdflib-endpoint serve ./src/assets/data/Beispieldaten.ttl ./src/assets/data/vocabulary.ttl"
    },
    "dependencies": {
        "@vueuse/core": "^12.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^9.1.2",
        "lucide-vue-next": "^0.468.0",
        "radix-vue": "^1.9.11",
        "tailwind-merge": "^2.5.5",
        "tailwindcss-animate": "^1.0.7",
        "vue": "^3.5.13",
        "vue-router": "^4.5.0"
    },
    "devDependencies": {
        "@iconify-json/radix-icons": "^1.2.1",
        "@iconify/vue": "^4.2.0",
        "@types/node": "^22.10.1",
        "@vitejs/plugin-vue": "^5.2.1",
        "autoprefixer": "^10.4.20",
        "postcss": "^8.4.49",
        "prettier": "^3.4.2",
        "tailwindcss": "^3.4.16",
        "typescript": "~5.6.2",
        "vite": "^6.0.1",
        "vue-tsc": "^2.1.10"
    }
}
