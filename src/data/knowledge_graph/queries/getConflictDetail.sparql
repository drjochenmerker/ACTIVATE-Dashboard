# Fetches a conflict, all information regarding the conflict and all comments belonging to said conflict

PREFIX : <http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

SELECT * WHERE {
  {
    SELECT ?conflict_p ?conflict_o
    WHERE {
        :{{conflict}} ?conflict_p ?conflict_o .
    }
  }
  UNION
  {
    SELECT ?s ?p ?o
    WHERE {
      :{{conflict}} (<>|!<>)* ?s .
      ?s rdf:type :Comment .
      ?s ?p ?o .
    }
    ORDER BY ?s
  }
}

