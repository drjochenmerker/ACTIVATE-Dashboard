PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX owl: <http://www.w3.org/2002/07/owl#> 
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

SELECT * WHERE {
  GRAPH graph:{{graph}} {
    {
      SELECT ?conflict_p ?conflict_o ?object_type
      WHERE {
          :{{conflict}} ?conflict_p ?conflict_o .
          FILTER (?conflict_p != rdf:type) .
          OPTIONAL {?conflict_o rdf:type ?object_type . FILTER (?object_type != owl:NamedIndividual)}
      }
    }
    UNION
    {
      SELECT ?s ?p ?o
      WHERE {
        :{{conflict}} (<>|!<>)* ?s .
        ?s rdf:type :Comment .
        ?s ?p ?o .
        FILTER (?p != rdf:type) .
      }
      ORDER BY ?s
    }
  }
}