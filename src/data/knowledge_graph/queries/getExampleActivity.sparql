PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

SELECT ?entity ?type ?property ?target
WHERE {
  ?entity rdf:type ?type .
  VALUES ?type { :Subject :Community :Instrument :Rule :Object}
  {
  	SELECT *
    WHERE {
    	?entity ?property ?target .
    }
  }
}
ORDER BY ?entity