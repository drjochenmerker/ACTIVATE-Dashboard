PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX owl: <http://www.w3.org/2002/07/owl#> 

DELETE {
    GRAPH graph:{{graph}} {
        :{{commentId}} :WrittenBy ?o1 .
        :{{commentId}} :CommentDescription ?o2 .
    }
}
INSERT {
    GRAPH graph:{{graph}} {
        :{{commentId}} :WrittenBy "Anonym" ;
        :CommentDescription "Kommentar wurde gelöscht" .
    }
}
WHERE {
    GRAPH graph:{{graph}} {
        :{{commentId}} :WrittenBy ?o1 .
        :{{commentId}} :CommentDescription ?o2 .
    }
}