PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>

DELETE { 
    GRAPH graph:{{graph}} {
        :{{conflictId}} :{{predicate}} ?o .
    }
}
INSERT {
    GRAPH graph:{{graph}} {
        :{{conflictId}} :{{predicate}} """{{newValue}}""" .
    }
}
WHERE {
    GRAPH graph:{{graph}} {
        :{{conflictId}} :{{predicate}} ?o .
    }
}