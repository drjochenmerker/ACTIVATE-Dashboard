PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

SELECT * WHERE {
    GRAPH graph:{{graph}} {
    {
        SELECT ?root_comment_id WHERE {
            :root :HasComment ?root_comment_id .
        }
    }
    UNION
    {
        SELECT ?s ?p ?o WHERE {
            :root :HasComment ?r_c .
            ?r_c (<>|!<>)* ?s .
            ?s ?p ?o .
            FILTER (?p != rdf:type) .
        }
    }
    }
}