PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>

DELETE {
    GRAPH graph:{{graph}} {
        :{{commentId}} :CommentDescription ?oldComment .
    }
}
INSERT {
    GRAPH graph:{{graph}} {
        :{{commentId}} :CommentDescription """{{comment}}""" .
    }
}
WHERE {
    GRAPH graph:{{graph}} {
        :{{commentId}} :CommentDescription ?oldComment .
    }
}
