PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

SELECT ?conflict_id ?conflict_title
WHERE {
  GRAPH graph:{{graph}} {    
    ?conflict_id rdf:type :Conflict .
    ?conflict_id :ConflictTitle ?conflict_title .
    # Language Filter - Remove as soon as frontend parsing can handle multi-language
   # FILTER (lang(?conflict_title) = "en" || lang(?conflict_title) = "")
  }
}