PREFIX : <http://activate.htwk-leipzig.de/model#> 
PREFIX graph: <http://activate.htwk-leipzig.de/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> 

INSERT DATA {
    GRAPH graph:{{graph}} {
        :{{commentId}} rdf:type :Comment ;
        :WrittenBy """{{author}}""" ;
        :CreationDate """{{created}}""" ;
        :CommentDescription """{{comment}}""" .
        :{{parentId}} :HasComment :{{commentId}}
    }
}