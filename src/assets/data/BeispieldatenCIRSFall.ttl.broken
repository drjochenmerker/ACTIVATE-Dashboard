@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory/> .


:UrologyEmergency a :Activity ;
 	rdfs:label "Compliance with the specifications for handling intravenous catheters" ;
	rdfs:comment "CIRS Case number: 270499		Description: An inpatient received emergency medical intervention in a specialised outpatient clinic during the night. The patient was then transferred to a monitoring ward and later brought back to the original peripheral ward by a nurse. On the ward, the nurse discovered that the extension set of the intravenous catheter (IVC) still contained residues of a cloudy-coloured medication (sedative). In addition, the intravenous catheter was covered by a gauze bandage. As a result, there was a risk that someone could rinse the IVC without checking the contents and inadvertently administer the remaining medication in the bolus to the patient." ;

:NursingSpecialist a :Subject ;
	:name "Nursing specialist 1" ;

:Patient a :Object ;
  	:name "Patient 1" ;
  	:age "unknown" ;
  	:sex  "unknown";

:ExtensionSet a :Instrument ;
	:name "Extension set for the intravenous catheter";
	:type "Medical instrument" ;

:Sedatives a :Instrument ;
	:name "Sedatives" ;
	:type "Medication" ;
	:description "Remains of a cloudy coloured medication (sedative)" ;

:GauzeBandage a :Instrument ;
	:name "GauzeBandage" ;
	:type "Bandages" ;

:HandlingOfIntravenousCatheters a Rule ;
	:name "Handling of intravenous catheters" ;
	:mistakes "Process gaps (guidelines for handling intravenous catheters were not trained)" ;

:NursingStaff a Community ;
	:name "Nursing staff" ;

:MedicalPracticeStaff a Community ;
	:name "Medical practice staff" ;






:ChangeMedicationPlan a :Activity ;
 	rdfs:label "Change of the medication plan" ;
	rdfs:comment "CIRS Case number: 200643		Description: Simultaneous prescription of colecalciferol (vitamin D3) [trade name] 20000 IU and alfacalcidol by clinic and GP, preparations simply added to medication plan and not cancelled" ;


:Patient a :Object ;
  	:name "Patient 2" ;
  	:age range "81-90" ;
  	:sex  "male";

:GeneralPractitioner a :Subject ;
	:name "General Practitioner 1" ;

:Colecalciferol a :Instrument ;
	:name "Colecalciferol" ;
	:type "Medication" ;

:Alfacalcidol a :Instrument ;
	:name "Alfacalcidol" ;
	:type "Medication" ;

:Clinic a Community ;
	:name "Clinic" ;

:SupplementMedicationPlan a DivisionOfLabour ;
	:comment "Supplement to medication plan without consultation with previous instance." ;
