###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/UrologyEmergency
:UrologyEmergency rdf:type owl:NamedIndividual ;
                  :ActivityDescription "CIRS Case number: 270499		Description: An inpatient received emergency medical intervention in a specialised outpatient clinic during the night. The patient was then transferred to a monitoring ward and later brought back to the original peripheral ward by a nurse. On the ward, the nurse discovered that the extension set of the intravenous catheter (IVC) still contained residues of a cloudy-coloured medication (sedative). In addition, the intravenous catheter was covered by a gauze bandage. As a result, there was a risk that someone could rinse the IVC without checking the contents and inadvertently administer the remaining medication in the bolus to the patient." ;
                  :ActivityName "Compliance with the specifications for handling intravenous catheters" .

#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory#NursingStaff
:NursingStaff rdf:type owl:NamedIndividual ,
                       :Community ;
              :InteractsWith :NursingSpecialist1 ;
              :Shares :Patient1 ;
              :CommunityName "Nursing Staff" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/ExtensionSet
:ExtensionSet rdf:type owl:NamedIndividual ,
                       :Instrument ;
              :AreUsedOn :Patient1 ;
              :InstrumentName "Extension set for the intravenous catheter" ;
              :InstrumentType "Medical Instrument" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/GauzeBandage
:GauzeBandage rdf:type owl:NamedIndividual ,
                       :Instrument ;
              :AreUsedOn :Patient1 ;
              :InstrumentName "Gauze Bandage" ;
              :InstrumentType "Bandages" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/HandlingOfIntravenousCatheters
:HandlingOfIntravenousCatheters rdf:type owl:NamedIndividual ,
                                         :Rule ;
                                :RegulatesActionOf :NursingSpecialist1 ;
                                :RuleName "Handling Of Intravenous Catheters" ;
                                :RuleViolation "Process gaps (guidelines for handling intravenous catheters were not trained)" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/NursingSpecialist1
:NursingSpecialist1 rdf:type owl:NamedIndividual ,
                             :Subject ;
                    :HasToFollow :HandlingOfIntravenousCatheters ;
                    :OperatesOn :Patient1 ;
                    :SubjectName "Nursing specialist 1" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/Patient1
:Patient1 rdf:type owl:NamedIndividual ,
                   :Object ;
          :DefinesTheApproachOf :NursingSpecialist1 ;
          :InfluencesTheChoiceOf :ExtensionSet ,
                                 :GauzeBandage ,
                                 :Sedatives ;
          :ObjectAge "unknown" ;
          :ObjectName "Patient1" ;
          :ObjectSex "unknown" .


###  http://www.semanticweb.org/tobia/ontologies/2025/0/activity_theory/Sedatives
:Sedatives rdf:type owl:NamedIndividual ,
                    :Instrument ;
           :AreUsedOn :Patient1 ;
           :InstrumentDescription "Remains of a cloudy coloured medication (sedative)" ;
           :InstrumentName "Sedatives" ;
           :InstrumentType "Medication" .


