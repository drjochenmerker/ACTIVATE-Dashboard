<http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory#DivisionOfLabour
:DivisionOfLabour rdf:type owl:Class ;
        rdfs:label "Division of Labour"@en ;
        rdfs:label "Arbeitsteilung"@de ;
        rdfs:label "Arbetsfördelning"@sv ;
        rdfs:comment "Who is responsible for what, when carrying out this activity and how the roles are organised."@en ;
        rdfs:comment "Wer ist für was verantwortlich, wenn man diese Aktivität durchführt und wie sind die Rollen organisiert."@de ;
        rdfs:comment "Vem är ansvarig för vad, när man utför denna aktivitet och hur är roller organiserade."@sv .

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory#Object
:Object rdf:type owl:Class ;
        rdfs:label "Object"@en ;
        rdfs:label "Objekt"@de ;
        rdfs:label "Objekt"@sv ;
        rdfs:comment "The reason why thsi activity takes place."@en ;
        rdfs:comment "Der Grund, warum diese Aktivität stattfindet."@de ;
        rdfs:comment "Orsaken till att denna aktivitet sker."@sv .

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory#Subject
:Subject rdf:type owl:Class ;
        rdfs:label "Subject"@en ;
        rdfs:label "Subjekt"@de ;
        rdfs:label "Subjekt"@sv ;
        rdfs:comment "The person who is carrying out this activity."@en ;
        rdfs:comment "Die Person, die diese Aktivität durchführt."@de ;
        rdfs:comment "Den person som utför denna aktivitet."@sv .

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory/Community
:Community rdf:type owl:Class ;
        rdfs:label "Community"@en ;
        rdfs:label "Gemeinschaft"@de ;
        rdfs:label "Samhälle"@sv ;
        rdfs:comment "The environment in which the activity is carried out."@en ;
        rdfs:comment "Die Umgebung, in der die Aktivität stattfindet."@de ;
        rdfs:comment "Miljön där aktivitet sker."@sv .

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory/Instruments
:Instrument rdf:type owl:Class ;
        rdfs:label "Instrument"@en ;
        rdfs:label "Instrument"@de ;
        rdfs:label "Instrument"@sv ;
        rdfs:comment "The means by which the subject carries out the activity."@en ;
        rdfs:comment "Die Mittel, mit denen das Subjekt die Aktivität durchführt."@de ;
        rdfs:comment "De medel som används av försökspersonen för att utföra aktiviteten."@sv .

###  http://www.semanticweb.org/tobia/ontologies/2024/10/Activity_Theory/Rules
:Rule rdf:type owl:Class ;
        rdfs:label "Rules"@en ;
        rdfs:label "Regeln"@de ;
        rdfs:label "Regler"@sv ;
        rdfs:comment "Cultural norms, rules and regulations governing the performance of this activity."@en ;
        rdfs:comment "Kulturelle Normen, Regeln und Vorschriften, die die Durchführung der Aktivität regeln."@de ;
        rdfs:comment "Kulturella normer, regler och bestämmelser som reglerar utförandet av denna aktivitet."@sv .

