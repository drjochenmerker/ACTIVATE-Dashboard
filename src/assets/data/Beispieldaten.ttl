 :uses :MedizinischeTerminologie ;
 :definesTheApproachOf :Arzt ;
 :determines :Schmerzmanagement ;
 :isInfluencedBy :Patient ;
 :influencesTheChoiceOf :Behandlung ;
 :shallBeAchievedBy :PalliativTeam ;
 :createsAndIsRegulatedBy :Regeln ;
 :developsAndUses :MedizinischeTerminologie ;
 :interactsWith :Patient ;
 :isOrganisedBy :DivisionOfLabour ;
 :shares :Patient ;
 :influences :Regeln ;
 :regulatesActionOf :Arzt ;
 :regulatesAndAreCreatedBy :PalliativTeam ;
