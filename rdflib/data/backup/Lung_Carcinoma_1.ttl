@prefix : <http://activate.htwk-leipzig.de/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://activate.htwk-leipzig.de/model> .

:SimulatedPatientDebriefing a owl:NamedIndividual ;
    :ActivityDescription "A feedback session analyzing a simulated medical consultation, focusing on effective communication in delivering difficult news in a palliative care setting."@en,
        "Eine Feedback-Sitzung zur Analyse einer simulierten medizinischen Konsultation, die sich auf effektive Kommunikation bei der Übermittlung schwieriger Nachrichten in einem palliativen Umfeld konzentriert."@de,
        "En återkopplingssession som analyserar en simulerad medicinsk konsultation, med fokus på effektiv kommunikation vid förmedling av svåra besked inom palliativ vård."@sv ;
    :ActivityName "Simulated Patient Debriefing"@en,
        "Patientensimulations-Debriefing"@de,
        "Debriefing av patientsimulering"@sv .

:GivesFeedbackTo rdf:type owl:ObjectProperty ;
    rdfs:domain :Subject ;
    rdfs:range :Subject ;
    rdfs:label "Gibt Feedback an"@de,
        "Ger feedback till"@sv,
        "Gives feedback to"@en .

:DiscussesWith rdf:type owl:ObjectProperty ;
    rdfs:domain :Subject ;
    rdfs:range :Subject ;
    rdfs:label "Bespricht mit"@de,
        "Diskuterar med"@sv,
        "Discusses with"@en .

:Dozent a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Dozent"@de,
        "Lecturer"@en,
        "Lektor"@sv ;
    :OperatesOn :GesprachsTiming .

:Aerztin a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Ärztin"@de,
        "Doctor"@en,
        "Läkare"@sv ;
    :HasToFollow :AutonomieWahren,
        :EinwilligungDesPatienten,
        :Gesprächszeitmanagement,
        :Patientenautonomie,
        :Patientenentscheidung ;
    :InstrumentDescription "The doctor's demeanor was described as 'cool', characterized by direct eye contact, concentration, nodding, and occasional repetition of statements. Her conversation pace was slow, giving the patient time. She perceived the atmosphere upon entering the room and left many pauses, allowing the patient to speak. Her sitting position was described as nice and calm."@en,
        "Die Haltung der Ärztin wurde als 'cool' beschrieben, gekennzeichnet durch direkten Augenkontakt, Konzentration, Nicken und gelegentliches Wiederholen von Aussagen. Ihr Gesprächstempo war langsam und gab der Patientin Zeit. Sie nahm die Stimmung beim Betreten des Raumes wahr und ließ viele Pausen, die die Patientin nutzte, um zu erzählen. Ihre Sitzposition wurde als sehr schön und ruhig beschrieben."@de,
        "Läkarens hållning beskrevs som 'cool', kännetecknad av direkt ögonkontakt, koncentration, nickningar och ibland upprepning av uttalanden. Hennes samtalstempo var långsamt och gav patienten tid. Hon uppfattade stämningen när hon kom in i rummet och lämnade många pauser som patienten använde för att berätta. Hennes sittställning beskrevs som mycket fin och lugn."@sv ;
    :InteractsIn :PalliativesSetting ;
    :OperatesOn :BotschaftUeberbringen,
        :BriefeOrganisieren,
        :EinsatzDesMultipersonellenTeams,
        :Erstickungsgefuehl,
        :FragenStellen,
        :GefuehlDerAerztin,
        :Gesprach,
        :Gesprachsabschluss,
        :InformationUeberPatientengeschichte,
        :KontrastGesundWerdenVsSterben,
        :Loesungsangebot,
        :Patientin,
        :PatientinAlleineLassen,
        :PragmatischeVorschlaege,
        :SchmerzenUndBeschwerden,
        :Seelsorge,
        :SeelsorgerSprechen,
        :SicherheitDerPatientin,
        :StrohhalmAnbieten,
        :UmgangMitSterben,
        :WortSterbenAussprechen,
        :Zuhoren ;
    :RuleDescription "The doctor preserved the patient's autonomy and sought the patient's consent before discussing with relatives. She managed the conversation time flexibly, allowing for a slight extension to ensure a natural and complete conclusion for the patient."@en,
        "Die Ärztin wahrte die Autonomie der Patientin und holte deren Einverständnis ein, bevor sie mit Angehörigen sprach. Sie managte die Gesprächszeit flexibel, um eine leichte Verlängerung zu ermöglichen und einen natürlichen und vollständigen Abschluss für die Patientin zu gewährleisten."@de,
        "Läkaren bevarade patientens autonomi och inhämtade patientens samtycke innan hon talade med anhöriga. Hon hanterade samtalstiden flexibelt, vilket möjliggjorde en viss förlängning för att säkerställa en naturlig och fullständig avslutning för patienten."@sv ;
    :Uses :Behutsamkeit,
        :GesprachsTiming,
        :Gesprachstempo,
        :HaltungDerAerztin,
        :KlarheitDerKommunikation,
        :Konzentration,
        :MuensterGesprach,
        :PausenImGesprach,
        :SitzpositionDerAerztin,
        :StimmungWahrnehmen .

:Kommilitonin a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Kommilitonin"@de,
        "Fellow Student"@en,
        "Medstudent"@sv ;
    :GivesFeedbackTo :Aerztin .

:Patientin a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Patientin"@de,
        "Patient"@en,
        "Patient"@sv ;
    :DiscussesWith :Lebenspartner ;
    :InteractsIn :Krankenhausaufenthalt,
        :PraefinaleSituation,
        :Station ;
    :IsDefinedBy :RolleAlsPatientin ;
    :OperatesOn :Besuchswunsch,
        :BriefeOrganisieren,
        :InformationsbeduerfnisDerPatientin,
        :InformationVerarbeiten,
        :Patientenreaktion,
        :SeelsorgerSprechen,
        :UmgangMitSterben,
        :Versorgung .

:Gesprach a :Object,
        owl:NamedIndividual ;
    rdfs:label "Gespräch"@de,
        "Conversation"@en,
        "Samtal"@sv .

:GefuehlDerAerztin a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Gefühl der Ärztin"@de,
        "Doctor's Feelings"@en,
        "Läkarens Känslor"@sv .

:BotschaftUeberbringen a :Object,
        owl:NamedIndividual ;
    rdfs:label "Botschaft überbringen"@de,
        "Conveying the Message"@en,
        "Förmedla Budskapet"@sv .

:Zuhoren a :Object,
        owl:NamedIndividual ;
    rdfs:label "Zuhören"@de,
        "Listening"@en,
        "Lyssna"@sv .

:PatientinAlleineLassen a :Object,
        owl:NamedIndividual ;
    rdfs:label "Patientin alleine lassen"@de,
        "Leaving the Patient Alone"@en,
        "Lämna Patienten Ensam"@sv .

:MuensterGesprach a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Münster-Gespräch"@de,
        "Münster Conversation"@en,
        "Münster-samtal"@sv ;
    :InstrumentDescription "The Münster conversation was used to bring a positive turn to the conversation, helping the patient think of positive things. It served as a break and a mindfulness exercise."@en,
        "Das Münster-Gespräch wurde genutzt, um eine positive Wendung in das Gespräch zu bringen und der Patientin zu helfen, an schöne Dinge zu denken. Es diente als Unterbrechung und Achtsamkeitsübung."@de,
        "Münster-samtalet användes för att ge samtalet en positiv vändning och hjälpa patienten att tänka på positiva saker. Det fungerade som en paus och en mindfulnessövning."@sv .

:Patientenreaktion a :Object,
        owl:NamedIndividual ;
    rdfs:label "Patientenreaktion"@de,
        "Patient's Reaction"@en,
        "Patientens Reaktion"@sv .

:HaltungDerAerztin a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Haltung der Ärztin"@de,
        "Doctor's Demeanor"@en,
        "Läkarens Hållning"@sv ;
    :InstrumentDescription "The doctor's demeanor was described as 'cool', characterized by direct eye contact, concentration, nodding, and occasional repetition of statements."@en,
        "Die Haltung der Ärztin wurde als 'cool' beschrieben, gekennzeichnet durch direkten Augenkontakt, Konzentration, Nicken und gelegentliches Wiederholen von Aussagen."@de,
        "Läkarens hållning beskrevs som 'cool', kännetecknad av direkt ögonkontakt, koncentration, nickningar och ibland upprepning av uttalanden."@sv .

:Konzentration a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Konzentration"@de,
        "Concentration"@en,
        "Koncentration"@sv ;
    :InstrumentDescription "The doctor maintained concentration on the patient during the conversation."@en,
        "Die Ärztin blieb während des Gesprächs auf die Patientin konzentriert."@de,
        "Läkaren bibehöll koncentrationen på patienten under samtalet."@sv .

:FragenStellen a :Object,
        owl:NamedIndividual ;
    rdfs:label "Fragen stellen"@de,
        "Asking Questions"@en,
        "Ställa Frågor"@sv .

:SchmerzenUndBeschwerden a :Object,
        owl:NamedIndividual ;
    rdfs:label "Schmerzen und Beschwerden"@de,
        "Pain and Complaints"@en,
        "Smärta och Besvär"@sv .

:InformationUeberPatientengeschichte a :Object,
        owl:NamedIndividual ;
    rdfs:label "Information über Patientengeschichte"@de,
        "Information on Patient History"@en,
        "Information om Patienthistorik"@sv .

:Gesprachstempo a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Gesprächstempo"@de,
        "Conversation Pace"@en,
        "Samtalstempo"@sv ;
    :InstrumentDescription "The conversation pace was slow, allowing the patient time to process information and respond."@en,
        "Das Gesprächstempo war langsam, was der Patientin Zeit gab, Informationen zu verarbeiten und zu antworten."@de,
        "Samtalstempot var långsamt, vilket gav patienten tid att bearbeta information och svara."@sv .

:Loesungsangebot a :Object,
        owl:NamedIndividual ;
    rdfs:label "Lösungsangebot"@de,
        "Offering Solutions"@en,
        "Erbjuda Lösningar"@sv .

:Erstickungsgefuehl a :Object,
        owl:NamedIndividual ;
    rdfs:label "Erstickungsgefühl"@de,
        "Feeling of Choking"@en,
        "Kvävningskänsla"@sv .

:PsychiaterPriester a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Psychiater/Priester"@de,
        "Psychiatrist/Priest"@en,
        "Psykiater/Präst"@sv .

:BriefeOrganisieren a :Object,
        owl:NamedIndividual ;
    rdfs:label "Briefe organisieren"@de,
        "Organizing Letters"@en,
        "Organisera Brev"@sv .

:StrohhalmAnbieten a :Object,
        owl:NamedIndividual ;
    rdfs:label "Strohhalm anbieten"@de,
        "Offering a Straw"@en,
        "Erbjuda Sugrör"@sv .

:StimmungWahrnehmen a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Stimmung wahrnehmen"@de,
        "Perceiving the Atmosphere"@en,
        "Uppfatta Stämningen"@sv ;
    :InstrumentDescription "The doctor perceived the atmosphere upon entering the room, demonstrating openness to the patient's current state, especially valuable in a palliative setting."@en,
        "Die Ärztin nahm die Stimmung beim Betreten des Raumes wahr und zeigte Offenheit für den aktuellen Zustand der Patientin, was besonders in einem palliativen Setting wertvoll war."@de,
        "Läkaren uppfattade stämningen när hon kom in i rummet och visade öppenhet för patientens nuvarande tillstånd, vilket var särskilt värdefullt i en palliativ vårdmiljö."@sv .

:PalliativesSetting a :Community,
        owl:NamedIndividual ;
    rdfs:label "Palliatives Setting"@de,
        "Palliative Setting"@en,
        "Palliativ Vårdmiljö"@sv .

:PausenImGesprach a :Instrument,
        owl:NamedIndividual ;
    rdfs:label "Pausen im Gespräch"@de,
        "Pauses in Conversation"@en,
        "Pauser i Samtalet"@sv ;
    :InstrumentDescription "Many pauses were left during the conversation, which the patient utilized to tell her story and process information."@en,
        "Es wurden viele Pausen im Gespräch gelassen, die die Patientin nutzte, um ihre Geschichte zu erzählen und Informationen zu verarbeiten."@de,
        "Många pauser lämnades under samtalet, vilka patienten använde för att berätta sin historia och bearbeta information."@sv .

:PragmatischeVorschlaege a :Object,
        owl:NamedIndividual ;
    rdfs:label "Pragmatische Vorschläge"@de,
        "Pragmatic Suggestions"@en,
        "Pragmatiska Förslag"@sv .

:Gesprachsabschluss a :Object,
        owl:NamedIndividual ;
    rdfs:label "Gesprächsabschluss"@de,
        "Conversation Conclusion"@en,
        "Samtalsavslutning"@sv .

:InformationsbeduerfnisDerPatientin a :Object,
        owl:NamedIndividual ;
    rdfs:label "Informationsbedürfnis der Patientin"@de,
        "Patient's Information Need"@en,
        "Patientens Informationsbehov"@sv .

:Krankenhausaufenthalt a :Community,
