:Doctor a :Subject,
        owl:NamedIndividual ;
    :HasToFollow :SPIKESModel ;
    :OperatesOn :Communication,
        :Diagnosis,
        :MedicalFindings,
        :PalliativeCare,
        :PatientCondition,
