@prefix : <http://activate.htwk-leipzig.de/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://activate.htwk-leipzig.de/model> .

:MedicalCommunicationDebriefing a owl:NamedIndividual ;
    :ActivityDescription "A feedback session within a medical training context, discussing and evaluating a doctor's communication with a patient regarding an imminent death prognosis."@en,
                         "Ein Feedbackgespräch im Rahmen einer medizinischen Ausbildung, in dem die Kommunikation einer Ärztin mit einer Patientin über eine nahende Todesprognose besprochen und bewertet wird."@de,
                         "En återkopplingssession inom medicinsk utbildning, där en läkares kommunikation med en patient angående en nära förestående dödsprognos diskuteras och utvärderas."@sv ;
    :ActivityName "Patient Communication Debriefing"@en,
                  "Feedbackgespräch zur Patientenkommunikation"@de,
                  "Återkoppling på patientkommunikation"@sv .

:Doctor a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Doctor"@en,
               "Ärztin"@de,
               "Läkare"@sv ;
    :HasToFollow :AdvanceDirective,
                 :PatientWish ;
    :OperatesOn :Communication,
                :PatientComfort,
                :PatientComprehension,
                :PatientFears,
                :PatientInformationNeeds,
                :PhysicalComfort,
                :Prognosis,
                :SimulationTask,
                :TimeSpentWithPatient ;
    :SubjectSex "female"@en,
                "weiblich"@de,
                "kvinnlig"@sv ;
    :Uses :Directness,
          :Euphemism,
          :ExudingCalmness,
          :Medication,
          :Pauses,
          :Rapport,
          :Sensitivity,
          :TheologicalContactPerson .

:FellowStudent a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Fellow Student"@en,
               "Kommilitonin"@de,
               "Medstudent"@sv ;
    :SubjectSex "female"@en,
                "weiblich"@de,
                "kvinnlig"@sv .

:Patient a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Patient"@en,
               "Patientin"@de,
               "Patient"@sv ;
    :InteractsIn :Clinic ;
    :SubjectSex "female"@en,
                "weiblich"@de,
                "kvinnlig"@sv .

:Lecturer a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Lecturer"@en,
               "Dozentin"@de,
               "Föreläsare"@sv ;
    :HasToFollow :HonestyInCommunication ;
    :OperatesOn :MedicalTreatment,
                :Prognosis ;
    :SubjectSex "female"@en,
                "weiblich"@de,
                "kvinnlig"@sv ;
    :Uses :Courage,
          :Directness .

:NursingStaff a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Nursing Staff"@en,
               "Pflegepersonal"@de,
               "Vårdpersonal"@sv ;
    :InteractsIn :Clinic ;
    :SubjectSex "female"@en,
                "weiblich"@de,
                "kvinnlig"@sv .

:Parents a :Subject,
        owl:NamedIndividual ;
    rdfs:label "Parents"@en,
               "Eltern"@de,
               "Föräldrar"@sv ;
    :OperatesOn :SayingGoodbye .

