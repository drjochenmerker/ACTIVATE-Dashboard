@prefix : <http://activate.htwk-leipzig.de/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

:activity_1 a owl:NamedIndividual ;
    :ActivityName "Gespräch über Sterbewunsch und Patientenbetreuung"@de, "Conversation about wish to die and patient care"@en, "Samtal om dödsönskan och patientvård"@sv ;
    :ActivityDescription "Eine ärztliche Gesprächssituation mit Patient und Feedback von Kommilitoninnen und Dozent, in der Themen wie Raum geben, Sterbewunsch, Symptomkontrolle, rechtliche Aspekte der Sterbehilfe und häusliche Versorgung bei ALS besprochen werden."@de, "A medical conversation situation with patient and feedback from fellow students and instructor, discussing topics such as giving space, wish to die, symptom control, legal aspects of assisted dying, and home care challenges in ALS."@en, "En medicinsk samtalssituation med patient och återkoppling från studiekamrater och lärare, där ämnen som att ge utrymme, dödsönskan, symtomkontroll, juridiska aspekter av assisterat döende och hemtjänstutmaningar vid ALS diskuteras."@sv .

:Dozent a :Subject, owl:NamedIndividual ;
    rdfs:label "Dozent"@de, "Instructor"@en, "Lärare"@sv .

:Ärztin a :Subject, owl:NamedIndividual ;
    rdfs:label "Ärztin"@de, "Physician (female)"@en, "Läkare (kvinna)"@sv .

:Kommilitonin_1 a :Subject, owl:NamedIndividual ;
    rdfs:label "Kommilitonin 1"@de, "Fellow Student 1"@en, "Studiekamrat 1"@sv .

:Kommilitonin_2 a :Subject, owl:NamedIndividual ;
    rdfs:label "Kommilitonin 2"@de, "Fellow Student 2"@en, "Studiekamrat 2"@sv .

:Patient a :Subject, owl:NamedIndividual ;
    rdfs:label "Patient"@de, "Patient"@en, "Patient"@sv .

:Gespräch a :Object, owl:NamedIndividual ;
    rdfs:label "Gespräch"@de, "Conversation"@en, "Samtal"@sv .

:Sterbewunsch a :Object, owl:NamedIndividual ;
    rdfs:label "Sterbewunsch"@de, "Wish to die"@en, "Dödsönskan"@sv .

:Raum_geben a :Instrument, owl:NamedIndividual ;
    rdfs:label "Raum geben"@de, "Giving space"@en, "Ge utrymme"@sv .

:Symptomkontrolle a :Instrument, owl:NamedIndividual ;
    rdfs:label "Symptomkontrolle"@de, "Symptom control"@en, "Symtomkontroll"@sv .

:Rechtliche_Aspekte_Sterbehilfe a :Rule, owl:NamedIndividual ;
    rdfs:label "Rechtliche Aspekte der Sterbehilfe"@de, "Legal aspects of assisted dying"@en, "Juridiska aspekter av assisterat döende"@sv .

:Häusliche_Versorgung_ALS a :Community, owl:NamedIndividual ;
    rdfs:label "Häusliche Versorgung bei ALS"@de, "Home care in ALS"@en, "Hemtjänst vid ALS"@sv .

:Emotionale_Bedächtigkeit a :Instrument, owl:NamedIndividual ;
    rdfs:label "Emotionale Bedächtigkeit"@de, "Emotional deliberation"@en, "Emotionell eftertänksamhet"@sv .

:Selbstbewusstsein a :Instrument, owl:NamedIndividual ;
    rdfs:label "Selbstbewusstsein"@de, "Self-confidence"@en, "Självförtroende"@sv .

:Medikamentöse_Linderung a :Instrument, owl:NamedIndividual ;
    rdfs:label "Medikamentöse Linderung"@de, "Medication-based relief"@en, "Medicinbaserad lindring"@sv .

:Vorsorgeplanung a :Instrument, owl:NamedIndividual ;
    rdfs:label "Vorsorgeplanung"@de, "Advance care planning"@en, "Framtidsplanering"@sv .

:Sterbehilfeorganisationen a :Community, owl:NamedIndividual ;
    rdfs:label "Sterbehilfeorganisationen"@de, "Assisted dying organizations"@en, "Organisationer för assisterat döende"@sv .

:Gesetzgebung_Deutschland a :Rule, owl:NamedIndividual ;
    rdfs:label "Gesetzgebung in Deutschland zum Thema Sterbehilfe"@de, "Legislation in Germany on assisted dying"@en, "Lagstiftning i Tyskland om assisterat döende"@sv .

:Patientenverfügung a :Instrument, owl:NamedIndividual ;
    rdfs:label "Patientenverfügung"@de, "Advance directive"@en, "Vårdtestamente"@sv .

:Vollmacht a :Instrument, owl:NamedIndividual ;
    rdfs:label "Vollmacht"@de, "Power of attorney"@en, "Fullmakt"@sv .

:Feedback_Kommilitonin_1 a :Instrument, owl:NamedIndividual ;
    rdfs:label "Feedback Kommilitonin 1"@de, "Feedback Fellow Student 1"@en, "Återkoppling studiekamrat 1"@sv .

:Feedback_Kommilitonin_2 a :Instrument, owl:NamedIndividual ;
    rdfs:label "Feedback Kommilitonin 2"@de, "Feedback Fellow Student 2"@en, "Återkoppling studiekamrat 2"@sv .

:Feedback_Patient a :Instrument, owl:NamedIndividual ;
    rdfs:label "Feedback Patient"@de, "Feedback Patient"@en, "Återkoppling patient"@sv .

:Feedback_Dozent a :Instrument, owl:NamedIndividual ;
    rdfs:label "Feedback Dozent"@de, "Feedback Instructor"@en, "Återkoppling lärare"@sv .

:Gefühl_von_Last a :Object, owl:NamedIndividual ;
    rdfs:label "Gefühl von Last"@de, "Feeling of being a burden"@en, "Känsla av att vara en börda"@sv .

:Konflikt_1 a :Conflict ;
    :ConflictTitle "Umgang mit dem Sterbewunsch und dem Raum für den Patienten"@de, "Handling the wish to die and giving patient space"@en, "Hantera dödsönskan och ge patienten utrymme"@sv ;
    :ConflictDescription "Die Ärztin gibt dem Patienten Raum und versucht wertfrei zu bleiben, jedoch wurde das Thema Sterben erst spät angesprochen, was von Kommilitonin 1 und 2 als Ausweichen wahrgenommen wurde."@de, "The physician gave the patient space and tried to be nonjudgmental, but the topic of dying was addressed late, perceived by fellow students as avoidance."@en, "Läkaren gav patienten utrymme och försökte vara icke-dömande, men ämnet döden togs upp sent, vilket studiekamrater uppfattade som undvikande."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Kommilitonin_1 ;
    :HasParticipant :Ärztin, :Patient, :Sterbewunsch, :Raum_geben ;
    :CreationDate "2024-06-01T12:00:00Z" .

:Kommentar_1 a :Comment ;
    :CommentDescription "Die Kommilitonin 2 ergänzt, dass die Stimme variiert wurde und eine offene ehrliche Antwort gegeben wurde, jedoch wünscht sie sich auch, dass das Wort Sterben früher genannt wird."@de, "Fellow Student 2 adds that voice variation and open honest answers were given, but also wishes the word dying was mentioned earlier."@en, "Studiekamrat 2 tillägger att röstvariation och öppna ärliga svar gavs, men önskar också att ordet döden nämndes tidigare."@sv ;
    :WrittenBy :Kommilitonin_2 ;
    :CreationDate "2024-06-01T12:15:00Z" .

:Konflikt_1 :HasComment :Kommentar_1 .

:Konflikt_2 a :Conflict ;
    :ConflictTitle "Gefühl von Last und Lösungsansatz"@de, "Feeling of being a burden and solution approach"@en, "Känsla av att vara en börda och lösningsförslag"@sv ;
    :ConflictDescription "Der Patient fühlt sich als Last und empfindet eine Reibung, als die Ärztin eine Lösung anbieten wollte, obwohl er keine Lösung braucht."@de, "The patient feels like a burden and experiences friction when the physician tried to offer a solution, although he does not need one."@en, "Patienten känner sig som en börda och upplever friktion när läkaren försökte erbjuda en lösning, trots att han inte behöver en."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Patient ;
    :HasParticipant :Patient, :Ärztin, :Gefühl_von_Last ;
    :CreationDate "2024-06-01T12:30:00Z" .

:Konflikt_3 a :Conflict ;
    :ConflictTitle "Selbstbewusstsein der Ärztin in der Gesprächsführung"@de, "Physician's self-confidence in conversation"@en, "Läkarens självförtroende i samtalet"@sv ;
    :ConflictDescription "Der Dozent gibt Feedback, dass die Ärztin selbstbewusster sein darf und ihre Leistung nicht relativieren muss."@de, "The instructor gives feedback that the physician may be more self-confident and should not downplay her performance."@en, "Läraren ger återkoppling att läkaren kan vara mer självsäker och inte ska nedvärdera sin prestation."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Dozent ;
    :HasParticipant :Ärztin, :Selbstbewusstsein ;
    :CreationDate "2024-06-01T12:45:00Z" .

:Konflikt_4 a :Conflict ;
    :ConflictTitle "Medikamentöse Linderung und Symptomkontrolle bei Sterbewunsch"@de, "Medication relief and symptom control in wish to die"@en, "Medicinering och symtomkontroll vid dödsönskan"@sv ;
    :ConflictDescription "Der Dozent erklärt, dass medikamentöse Linderung bei Symptomen wie Ersticken möglich ist, auch wenn die physiologischen Grenzen bestehen."@de, "The instructor explains that medication relief is possible for symptoms like suffocation, despite physiological limits."@en, "Läraren förklarar att medicinering är möjlig för symtom som kvävning, trots fysiologiska begränsningar."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Dozent ;
    :HasParticipant :Medikamentöse_Linderung, :Symptomkontrolle, :Ärztin ;
    :CreationDate "2024-06-01T13:00:00Z" .

:Konflikt_5 a :Conflict ;
    :ConflictTitle "Häusliche Versorgung bei ALS und mögliche Alternativen"@de, "Home care in ALS and possible alternatives"@en, "Hemtjänst vid ALS och möjliga alternativ"@sv ;
    :ConflictDescription "Der Dozent weist darauf hin, dass häusliche Versorgung bei ALS schwierig sein kann und fachliche Einrichtungen eine Alternative darstellen können."@de, "The instructor points out that home care in ALS can be difficult and professional facilities may be an alternative."@en, "Läraren påpekar att hemtjänst vid ALS kan vara svårt och professionella anläggningar kan vara ett alternativ."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Dozent ;
    :HasParticipant :Häusliche_Versorgung_ALS, :Ärztin ;
    :CreationDate "2024-06-01T13:15:00Z" .

:Konflikt_6 a :Conflict ;
    :ConflictTitle "Rechtliche Situation der Sterbehilfe in Deutschland"@de, "Legal situation of assisted dying in Germany"@en, "Juridisk situation för assisterat döende i Tyskland"@sv ;
    :ConflictDescription "Der Dozent erläutert die liberale Gesetzgebung in Deutschland zur Sterbehilfe und die Autonomie des Patienten sowie der Ärzte."@de, "The instructor explains the liberal legislation in Germany on assisted dying and the autonomy of patients and physicians."@en, "Läraren förklarar den liberala lagstiftningen i Tyskland om assisterat döende och patienters och läkares autonomi."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Dozent ;
    :HasParticipant :Gesetzgebung_Deutschland, :Sterbehilfeorganisationen, :Ärztin ;
    :CreationDate "2024-06-01T13:30:00Z" .

:Ärztin :gibtRaum :Patient ;
    :berät :Patient ;
    :vermeidetWertung :Sterbewunsch ;
    :nutztInstrument :Raum_geben, :Symptomkontrolle, :Patientenverfügung, :Vollmacht .

:Kommilitonin_1 :gibtFeedbackZu :Ärztin ;
    :lobt :Raum_geben ;
    :kritisiert :Sterbewunsch .

:Kommilitonin_2 :gibtFeedbackZu :Ärztin ;
    :lobt :Emotionale_Bedächtigkeit ;
    :kritisiert :Sterbewunsch .

:Patient :gibtFeedbackZu :Ärztin ;
    :äußertGefühl :Gefühl_von_Last ;
    :lobt :Raum_geben .

:Dozent :gibtFeedbackZu :Ärztin ;
    :erklärt :Medikamentöse_Linderung, :Rechtliche_Aspekte_Sterbehilfe, :Häusliche_Versorgung_ALS ;
    :ermutigt :Selbstbewusstsein ;
    :lobt :Emotionale_Bedächtigkeit .