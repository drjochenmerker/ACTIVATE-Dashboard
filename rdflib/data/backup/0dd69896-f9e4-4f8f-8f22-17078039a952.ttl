:Conflict01 a :Conflict ;
    :ConflictTitle "Positive Erfahrung mit Zuhören und Verstehenwollen"@de ;
    :ConflictTitle "Positive experience with listening and wanting to understand"@en ;
    :ConflictTitle "Positiv upplevelse med att lyssna och vilja förstå"@sv ;
    :ConflictDescription "Die Pflegekraft empfand das Zuhören und das Bestreben, andere zu verstehen, als einen sehr positiven und konstruktiven Aspekt der Aktivität."@de ;
    :ConflictDescription "The nurse found the act of listening to others and wanting to understand them to be a very positive and constructive aspect of the activity."@en ;
    :ConflictDescription "Sjuksköterskan upplevde att lyssna på andra och vilja förstå dem som en mycket positiv och konstruktiv aspekt av aktiviteten."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Pflege01 ;
    :HasParticipant :Pflege01, :Zuhören, :VerstehenWollen ;
    :CreationDate "2025-09-16T12:21:19.556Z" ;
    :IsAI true ;
    :HasIntent :Positive ;
    :Origin "{"question": "2. Denken Sie an einen Teil der Aktivität, den Sie sehr positiv, konstruktiv oder befriedigend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.", "answer": "... dem Anderen zuhören und verstehen woĺlen"}" .

:Conflict02 a :Conflict ;
    :ConflictTitle "Negative Erfahrung mit dominierender Haltung"@de ;
    :ConflictTitle "Negative experience with dominating attitude"@en ;
    :ConflictTitle "Negativ upplevelse med dominerande attityd"@sv ;
    :ConflictDescription "Die Pflegekraft empfand eine dominierende Haltung während der Aktivität als negativ und kontraproduktiv."@de ;
    :ConflictDescription "The nurse experienced a dominating attitude during the activity, which they found negative and counterproductive."@en ;
    :ConflictDescription "Sjuksköterskan upplevde en dominerande attityd under aktiviteten, vilket de fann negativt och kontraproduktivt."@sv ;
    :ConflictState "open" ;
    :WrittenBy :Pflege01 ;
    :HasParticipant :Pflege01, :DominierendeHaltung ;
    :CreationDate "2025-09-16T12:21:19.556Z" ;
    :IsAI true ;
    :HasIntent :Negative ;
