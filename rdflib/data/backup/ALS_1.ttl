:Doctor a :Subject, owl:NamedIndividual ;
    rdfs:label "Ärztin"@de, "Doctor"@en, "Läkare"@sv ;
    :Relation_1 :Conversation ;
    :Relation_2 :GivingSpace ;
    :DefinesTheApproachOf :DeathWish ;
    :Relation_4 :Counseling ;
    :Uses :PatienceEndurance, :Chair, :VoiceModulation, :SelfDisclosure, :NonVerbalCommunication, :HumanityEmpathy, :DeliberationThoughtfulness, :SpecializedKnowledge, :Confidence, :Skills ;
    :OperatesOn :Medication, :ConcludingDiscussion, :PatientAdvanceDirective, :PowerOfAttorney, :Sedation, :PainRelief, :EuthanasiaAssistedSuicide, :RestoringEnvironment, :ProvidingSolutions, :InformationExchange, :VoluntaryRefusalOfFoodAndFluids, :Suffocation, :MedicinalRelief, :SymptomControl, :AcceptingAddressingAlternatives, :WarningConversation ;
    :InteractsWith :Mother, :Friends .

:Lecturer a :Subject, owl:NamedIndividual ;
    rdfs:label "Dozent"@de, "Lecturer"@en, "Föreläsare"@sv ;
    :OperatesOn :Conversation .

:Patient a :Subject, owl:NamedIndividual ;
    rdfs:label "Patient"@de, "Patient"@en, "Patient"@sv ;
    :OperatesOn :GivingSpace, :Dying, :Inquiries, :InformationExchange, :ReducedFoodIntake, :ALS, :EuthanasiaAssistedSuicide ;
    :InteractsIn :HomeCare, :SpecializedFacility .

:Student1 a :Subject, owl:NamedIndividual ;
    rdfs:label "Kommilitonin 1"@de, "Student 1"@en, "Student 1"@sv ;
    :OperatesOn :Conversation .

:Student2 a :Subject, owl:NamedIndividual ;
    rdfs:label "Kommilitonin 2"@de, "Student 2"@en, "Student 2"@sv ;
    :OperatesOn :Conversation .

:Mother a :Subject, owl:NamedIndividual ;
    rdfs:label "Mutter"@de, "Mother"@en, "Mamma"@sv .

:Friends a :Subject, owl:NamedIndividual ;
    rdfs:label "Freunde"@de, "Friends"@en, "Vänner"@sv .

:DepressedPeople a :Subject, owl:NamedIndividual ;
    rdfs:label "Depressive Menschen"@de, "Depressed People"@en, "Deprimerade personer"@sv ;
    :OperatesOn :WishToCommitSuicide .

:MedicalProfessionals a :Subject, owl:NamedIndividual ;
    rdfs:label "Ärzte/Ärztinnen"@de, "Medical Professionals"@en, "Läkare/Medicinsk personal"@sv ;
    :OperatesOn :DeathWish, :AdvanceCarePlanning ;
    :HasToFollow :PhysicianAutonomyRefusalEuthanasia .

:Conversation a :Object, owl:NamedIndividual ;
    rdfs:label "Gespräch"@de, "Conversation"@en, "Samtal"@sv .

:GivingSpace a :Object, owl:NamedIndividual ;
    rdfs:label "Raum geben"@de, "Giving Space"@en, "Ge utrymme"@sv .

:DeathWish a :Object, owl:NamedIndividual ;
    rdfs:label "Todeswunsch"@de, "Death Wish"@en, "Dödsönskan"@sv .

:Counseling a :Object, owl:NamedIndividual ;
    rdfs:label "Beraten"@de, "Counseling"@en, "Rådgivning"@sv .

:ConcludingDiscussion a :Object, owl:NamedIndividual ;
    rdfs:label "Abschlussgespräch"@de, "Concluding Discussion"@en, "Avslutande diskussion"@sv .

:Dying a :Object, owl:NamedIndividual ;
    rdfs:label "Sterben"@de, "Dying"@en, "Att dö"@sv .

:Sedation a :Object, owl:NamedIndividual ;
    rdfs:label "Sedieren"@de, "Sedation"@en, "Sedering"@sv .

