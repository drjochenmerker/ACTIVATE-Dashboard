               "Medicinsk personal måste följa sin autonomi gällande vägran av eutanasi"@sv .

:Relation_54 rdf:type owl:ObjectProperty ;
    rdfs:domain :PhysicianAutonomyRefusalEuthanasia ;
    rdfs:range :EuthanasiaAssistedSuicide ;
