@prefix : <http://activate.htwk-leipzig.de/model#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://activate.htwk-leipzig.de/model> .

:EndofLifeCareDebriefing a owl:NamedIndividual ;
    :ActivityDescription "A debriefing session following a simulated patient consultation, focusing on communication with a patient expressing a wish to die, palliative care, and legal aspects of assisted dying. Participants include a physician, students, and an instructor."@en,
                         "Eine Debriefing-Sitzung nach einer simulierten Patientenberatung, die sich auf die Kommunikation mit einem Patienten mit Todeswunsch, Palliativversorgung und rechtliche Aspekte der Sterbehilfe konzentriert. Beteiligt sind eine Ärztin, Studierende und ein Dozent."@de,
                         "En debriefingsession efter en simulerad patientkonsultation, med fokus på kommunikation med en patient som uttrycker en önskan att dö, palliativ vård och juridiska aspekter av assisterat döende. Deltagare inkluderar en läkare, studenter och en instruktör."@sv ;
    :ActivityName "Medical Simulation Debriefing"@en,
                  "Debriefing einer medizinischen Simulation"@de,
                  "Medicinsk simuleringsdebriefing"@sv .

:Relation_1 rdf:type owl:ObjectProperty ;
    rdfs:domain :Doctor ;
    rdfs:range :Conversation ;
    rdfs:label "The doctor conducted the conversation"@en,
               "Die Ärztin führte das Gespräch"@de,
               "Läkaren genomförde samtalet"@sv .

:Relation_2 rdf:type owl:ObjectProperty ;
    rdfs:domain :Doctor ;
    rdfs:range :GivingSpace ;
    rdfs:label "The doctor provided space"@en,
               "Die Ärztin gab Raum"@de,
               "Läkaren gav utrymme"@sv .

