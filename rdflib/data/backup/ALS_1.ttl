               "Tredje riket orsakade en kränkning av autonomi"@sv .

:Relation_50 rdf:type owl:ObjectProperty ;
    rdfs:domain :Autonomy ;
    rdfs:range :LegislationGermany ;
    rdfs:label "Autonomy influences legislation in Germany"@en,
