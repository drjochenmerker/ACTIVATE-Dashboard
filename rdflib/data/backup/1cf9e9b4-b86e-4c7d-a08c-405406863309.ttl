:ALSExampleSimulation a owl:NamedIndividual ;
    :ActivityDescription "Ein*e Patient*in mit Amyotropher Lateralsklerose (ALS), die vor etwa einem Jahr diagnostiziert wurde, ist zunehmend bettlägerig und hat Schwierigkeiten beim Sprechen und Essen. Der*die Patient*in, der*die in der SAPV betreut wird, wünscht ein persönliches Gespräch, möchte das Thema aber nicht telefonisch nennen."@de,
        "A patient with Amyotrophic Lateral Sclerosis (ALS), diagnosed about a year ago, is increasingly bedridden and has difficulty speaking and eating. The patient, who is in SAPV, requests a personal conversation but does not want to disclose the topic by phone."@en,
        "En patient med Amyotrofisk Lateralskleros (ALS), diagnostiserad för ungefär ett år sedan, är alltmer sängliggande och har svårt att tala och äta. Patienten, som vårdas inom SAPV, önskar ett personligt samtal men vill inte avslöja ämnet via telefon."@sv ;
    :ActivityName "ALS Beispiel"@de,
        "ALS Example"@en,
        "ALS Exempel"@sv .

:AmyotrophicLateralSclerosis a :Object,
        owl:NamedIndividual ;
    rdfs:label "Amyotrophe Lateralsklerose (ALS)"@de,
        "Amyotrophic Lateral Sclerosis (ALS)"@en,
        "Amyotrofisk lateralskleros (ALS)"@sv .

:Conflict_1 a :Conflict ;
    :ConflictDescription "Der Teilnehmer empfand das Gespräch trotz der schwierigen Situation als sehr angenehm und hatte das Gefühl, dass genügend Raum für seine Beiträge und Gefühle vorhanden war."@de,
        "The participant experienced the conversation as very pleasant despite the difficult situation and felt that there was enough room for their input and feelings."@en,
        "Deltagaren upplevde samtalet som mycket trevligt trots den svåra situationen och kände att det fanns tillräckligt med utrymme för deras input och känslor."@sv ;
    :ConflictState "open" ;
    :ConflictTitle "Angenehmes Gespräch und Gefühl von Raum"@de,
        "Pleasant Conversation and Feeling of Space"@en,
        "Trevligt samtal och känsla av utrymme"@sv ;
    :CreationDate "2025-08-26T14:22:18.379Z" ;
    :HasIntent :Positive ;
    :HasParticipant :FeelingOfHavingEnoughSpace,
        :PatientsDesireForDiscretion,
        :PleasantConversation ;
    :IsAI true ;
    :Origin "{ \"question\": \"1. Was denken Sie über die Simulation der interprofessionellen Zusammenarbeit, die Sie gerade abgeschlossen haben?\", \"answer\": \"sehr angenehmes Gespräch trotz der Situation\\n- hatte das Gefühl genug Raum zu haben\" }" ;
    :WrittenBy :PatientsDesireForDiscretion .

:Conflict_1_Q1A1 a :Conflict ;
    :ConflictDescription "Der Ausbilder empfand die Simulation der interprofessionellen Zusammenarbeit als ein richtig gutes Gespräch."@de,
        "The instructor perceived the interprofessional collaboration simulation as a really good conversation."@en,
        "Instruktören uppfattade simuleringen av interprofessionell samverkan som ett riktigt bra samtal."@sv ;
    :ConflictState "inDiscussion" ;
    :ConflictTitle "Gutes Gespräch"@de,
        "Good Conversation"@en,
        "Bra samtal"@sv ;
    :CreationDate "2025-08-26T14:21:04.581Z" ;
    :HasIntent :Positive ;
    :HasParticipant :GoodConversation,
        :Instructor,
        :InterprofessionalCollaboration ;
    :IsAI true ;
    :Origin "{\"question\": \"1. Was denken Sie über die Simulation der interprofessionellen Zusammenarbeit, die Sie gerade abgeschlossen haben?\", \"answer\": \"richtig gutes Gespräch\"}" ;
    :WrittenBy :Instructor .

:Conflict_2 a :Conflict ;
    :ConflictDescription "Der Teilnehmer bemerkte positiv, dass die Ärztin ruhig sprach und konkrete Nachfragen stellte, was zu einer konstruktiven Interaktion beitrug."@de,
        "The participant positively noted that the doctor spoke calmly and asked specific questions, which contributed to a constructive interaction."@en,
        "Deltagaren noterade positivt att läkaren talade lugnt och ställde specifika frågor, vilket bidrog till en konstruktiv interaktion."@sv ;
    :ConflictState "resolved" ;
    :ConflictTitle "Ruhige Kommunikation und konkrete Nachfragen der Ärztin"@de,
        "Doctor's Calm Communication and Specific Inquiries"@en,
        "Läkarens lugna kommunikation och specifika frågor"@sv ;
    :CreationDate "2025-08-26T14:22:18.379Z" ;
    :HasIntent :Positive ;
    :HasParticipant :CalmCommunication,
        :DoctorRole,
        :PatientsDesireForDiscretion,
        :SpecificInquiries ;
    :IsAI true ;
    :Origin "{ \"question\": \"2. Denken Sie an einen Teil der Aktivität, den Sie sehr positiv, konstruktiv oder befriedigend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"Ärztin hat ruhig gesprochen\\nkonkrete Nachfragen\" }" ;
    :WrittenBy :PatientsDesireForDiscretion .

:Conflict_2_Q2A2 a :Conflict ;
    :ConflictDescription "Der Ausbilder empfand das Fragen nach den Wünschen des Patienten und das Erhalten offener und ehrlicher Antworten auf Patientenfragen als sehr positiv, konstruktiv und befriedigend."@de,
        "The instructor found the act of asking about the patient's wishes and receiving open and honest answers to patient questions to be very positive, constructive, and satisfying."@en,
        "Instruktören fann att frågan om patientens önskemål och att få öppna och ärliga svar på patientfrågor var mycket positivt, konstruktivt och tillfredsställande."@sv ;
    :ConflictState "resolved" ;
    :ConflictTitle "Positive Aspekte der Patientenkommunikation"@de,
        "Positive Aspects of Patient Communication"@en,
        "Positiva aspekter av patientkommunikation"@sv ;
    :CreationDate "2025-08-26T14:21:04.581Z" ;
    :HasIntent :Positive ;
    :HasParticipant :AskingForPatientsWishes,
        :Instructor,
        :OpenAndHonestAnswers,
        :PatientQuestions,
        :PatientsGeneralWishes ;
    :IsAI true ;
    :Origin "{\"question\": \"2. Denken Sie an einen Teil der Aktivität, den Sie sehr positiv, konstruktiv oder befriedigend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"Frage nach Wünschen des Patienten\\noffene und ehrliche Antworten auf Patientenfragen\"}" ;
    :WrittenBy :Instructor .

:Conflict_3 a :Conflict ;
    :ConflictDescription "Der Teilnehmer bemerkte, dass die Ärztin zum Ende hin distanzierter in Mimik und Gestik wurde und zu vorschnell Lösungen anbot, was negativ empfunden wurde."@de,
        "The participant observed that the doctor became more distant in her body language towards the end and offered solutions too prematurely, which was perceived negatively."@en,
        "Deltagaren observerade att läkaren blev mer distanserad i sitt kroppsspråk mot slutet och erbjöd lösningar för förhastat, vilket upplevdes negativt."@sv ;
    :ConflictState "open" ;
    :ConflictTitle "Distanzierte Mimik und Gestik sowie vorschnelle Lösungen der Ärztin"@de,
        "Doctor's Distant Body Language and Premature Solutions"@en,
        "Läkarens distanserade kroppsspråk och förhastade lösningar"@sv ;
    :CreationDate "2025-08-26T14:22:18.379Z" ;
    :HasIntent :Negative ;
    :HasParticipant :DistantBodyLanguage,
        :DoctorRole,
        :PatientsDesireForDiscretion,
        :PrematureSolutions ;
    :IsAI true ;
    :Origin "{ \"question\": \"3. Denken Sie an einen Teil der Aktivität, den Sie sehr negativ, kontraproduktiv oder enttäuschend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"zum Ende war Ärztin distanzierter in Mimik und Gestik als am Anfang\\nzu vorschnell Lösungen angeboten\" }" ;
    :WrittenBy :PatientsDesireForDiscretion .

:Conflict_3_Q3A3 a :Conflict ;
    :ConflictDescription "Der Ausbilder empfand es als negativ, dass die Ärztin das Wort 'Sterben' zu spät in der Aktivität verwendete, was auf eine mangelnde rechtzeitige Kommunikation hindeutet."@de,
        "The instructor found it negative that the physician used the word 'dying' too late in the activity, indicating a lack of timely communication."@en,
        "Instruktören fann det negativt att läkaren använde ordet 'döende' för sent i aktiviteten, vilket indikerar bristande tidig kommunikation."@sv ;
    :ConflictState "inDiscussion" ;
    :ConflictTitle "Verzögerte Sterbediskussion"@de,
        "Delayed Discussion of Dying"@en,
        "Försenad diskussion om döende"@sv ;
    :CreationDate "2025-08-26T14:21:04.581Z" ;
    :HasIntent :Negative ;
    :HasParticipant :DiscussingDying,
        :Physician ;
    :IsAI true ;
    :Origin "{\"question\": \"3. Denken Sie an einen Teil der Aktivität, den Sie sehr negativ, kontraproduktiv oder enttäuschend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"Ärztin hat Wort Sterben zu spät genutzt\"}" ;
    :WrittenBy :Instructor .

:Conflict_SAPVStaffMember_1 a :Conflict ;
    :ConflictDescription "Der SAPV-Mitarbeiter empfand das Gespräch als angenehm, verspürte aber gleichzeitig eine gewisse Unsicherheit."@de,
        "The SAPV staff member experienced the conversation as pleasant but simultaneously felt a degree of uncertainty."@en,
        "SAPV-medarbetaren upplevde samtalet som trevligt men kände samtidigt en viss osäkerhet."@sv ;
    :ConflictState "resolved" ;
    :ConflictTitle "Gemischte Gefühle bezüglich des Gesprächs"@de,
        "Mixed Feelings about Conversation"@en,
        "Blandade känslor om samtalet"@sv ;
    :CreationDate "2025-08-26T14:19:51.801Z" ;
    :HasIntent :Neutral ;
    :HasParticipant :PleasantConversation,
        :SAPVStaffMember,
        :UncertaintyOfSAPVStaffMember ;
    :IsAI true ;
    :Origin "{\"question\": \"1. Was denken Sie über die Simulation der interprofessionellen Zusammenarbeit, die Sie gerade abgeschlossen haben?\", \"answer\": \"angenehmes Gespräch, trotzdem war ich etwas unsicher\"}" ;
    :WrittenBy :SAPVStaffMember .

:Conflict_SAPVStaffMember_2 a :Conflict ;
    :ConflictDescription "Der SAPV-Mitarbeiter hatte das Gefühl, dem Patienten viel Raum gegeben und eine möglichst wenig wertende Haltung eingenommen zu haben."@de,
        "The SAPV staff member felt they successfully gave the patient ample space and maintained a non-judgmental attitude during the interaction."@en,
        "SAPV-medarbetaren kände att de framgångsrikt gav patienten gott om utrymme och upprätthöll en icke-dömande attityd under interaktionen."@sv ;
    :ConflictState "resolved" ;
    :ConflictTitle "Positiver Ansatz in der Patienteninteraktion"@de,
        "Positive Approach to Patient Interaction"@en,
        "Positivt förhållningssätt till patientinteraktion"@sv ;
    :CreationDate "2025-08-26T14:19:51.801Z" ;
    :HasIntent :Positive ;
    :HasParticipant :GivingSpaceToPatient,
        :NonJudgmentalAttitude,
        :SAPVStaffMember ;
    :IsAI true ;
    :Origin "{\"question\": \"2. Denken Sie an einen Teil der Aktivität, den Sie sehr positiv, konstruktiv oder befriedigend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"hatte das Gefühl dem Patienten viel Raum zu geben\\nhabe versucht möglichst wenig wertend zu sein\"}" ;
    :WrittenBy :SAPVStaffMember .

:Conflict_SAPVStaffMember_3 a :Conflict ;
    :ConflictDescription "Der SAPV-Mitarbeiter äußerte weiterhin Unsicherheit darüber, den richtigen Zeitpunkt zum Sprechen oder Eingreifen während der Interaktion zu finden."@de,
        "The SAPV staff member expressed ongoing uncertainty about identifying the appropriate moment to speak or intervene during the interaction."@en,
        "SAPV-medarbetaren uttryckte fortsatt osäkerhet kring att identifiera rätt tidpunkt att tala eller ingripa under interaktionen."@sv ;
    :ConflictState "open" ;
    :ConflictTitle "Unsicherheit bezüglich des Zeitpunkts der Intervention"@de,
        "Uncertainty Regarding Intervention Timing"@en,
        "Osäkerhet gällande tidpunkt för intervention"@sv ;
    :CreationDate "2025-08-26T14:19:51.801Z" ;
    :HasIntent :Negative ;
    :HasParticipant :SAPVStaffMember,
        :TimingOfIntervention,
        :UncertaintyOfSAPVStaffMember ;
    :IsAI true ;
    :Origin "{\"question\": \"3. Denken Sie an einen Teil der Aktivität, den Sie sehr negativ, kontraproduktiv oder enttäuschend fanden. Bitte beschreiben Sie in einigen Sätzen, was in dieser Phase passiert ist.\", \"answer\": \"noch unsicher, wann richtiger Moment zum Sprechen\"}" ;
    :WrittenBy :SAPVStaffMember .

